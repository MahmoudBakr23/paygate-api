# Database — only set on production/staging (Render sets this automatically)
# Local dev uses database.yml with OS user — do not set DATABASE_URL here
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis
REDIS_URL=redis://localhost:6379/0

# Rails
RAILS_ENV=development
SECRET_KEY_BASE=changeme_generate_with_rails_secret

# CORS — comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# Payment Providers — filled in Phase 2
STRIPE_SANDBOX_SECRET_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_SANDBOX_WEBHOOK_SECRET=
STRIPE_LIVE_WEBHOOK_SECRET=

CHECKOUT_SANDBOX_SECRET_KEY=
CHECKOUT_LIVE_SECRET_KEY=
CHECKOUT_SANDBOX_WEBHOOK_SECRET=
CHECKOUT_LIVE_WEBHOOK_SECRET=

# Sentry — filled in Phase 6
SENTRY_DSN=
